{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VIBDL",
  "version": "0.2.0",
  "identifier": "com.vibdl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VIBDL",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VIBDL (personal build)",
    "shortDescription": "Vibecoded Image Board Downloader Library",
    "longDescription": "Browse imageboards, download originals with their metadata, and organize them in a searchable offline library.",
    "category": "Photography",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VIBDL",
  "version": "0.4.0",
  "identifier": "io.github.aemrican123.vibdl",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "VIBDL",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: thumb: library: http://thumb.localhost http://library.localhost",
        "media-src": "'self' blob: media: thumb: library: http://media.localhost http://thumb.localhost http://library.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "aemrican123",
    "shortDescription": "Vibecoded Image Board Downloader Library",
    "longDescription": "Browse imageboards, download originals with their metadata, and organize them in a searchable offline library.",
    "category": "Photography",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "copyright": "Copyright (c) 2026 aemrican123. MIT OR Apache-2.0.",
    "homepage": "https://github.com/aemrican123/vibdl",
    "license": "MIT OR Apache-2.0"
  }
}
